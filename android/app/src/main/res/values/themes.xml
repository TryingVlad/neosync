<resources>
    <!-- E-ink first: pure black on white, no action bar, no ripples or animations. -->
    <style name="Theme.NeoSync" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorAccent">@color/black</item>
        <item name="android:colorControlActivated">@color/black</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>

    <!-- Bottom sheets: no slide-in, no dark dim (the scrim is drawn white instead). -->
    <style name="NeoSync.BottomSheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/NeoSync.BottomSheet.Sheet</item>
    </style>

    <style name="NeoSync.BottomSheet.Sheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/sheet_bg</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="NeoSync.Link" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginEnd">28dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="NeoSync.Title" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="NeoSync.Section" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="NeoSync.Body" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="NeoSync.Small" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="NeoSync.Button" parent="">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="NeoSync.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="NeoSync.Button.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
    </style>

    <style name="NeoSync.Field" parent="">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/ink_soft</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="NeoSync.Card" parent="">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
