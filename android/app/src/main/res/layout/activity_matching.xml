<?xml version="1.0" encoding="utf-8"?>
<!-- Book matching (spec 5.4 Advanced): the two modes and a warning to use the same on both devices. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">

<!-- Header: back arrow + title. -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageButton android:id="@+id/button_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="-12dp" android:src="@drawable/ic_arrow_back" android:background="@null" android:padding="12dp" android:contentDescription="@string/cd_back" />

<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/matching_title" style="@style/NeoSync.Title" />
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/label_match_method" style="@style/NeoSync.Body" />

<RadioGroup android:id="@+id/group_match_method" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
<RadioButton android:id="@+id/radio_match_filename" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/match_filename" android:textSize="17sp" android:textColor="@color/black" />
<RadioButton android:id="@+id/radio_match_binary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/match_binary" android:textSize="17sp" android:textColor="@color/black" />
</RadioGroup>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/warn_bg" android:text="@string/matching_warning" style="@style/NeoSync.Body" />
</LinearLayout>
</ScrollView>
