<?xml version="1.0" encoding="utf-8"?>
<!-- Fix covers sheet (spec 5.6, mockup 7): before -> after rows, the Picco
     warning, the Picco-only tick box, one primary button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/grab_bg" />

        <TextView
            android:id="@+id/cover_heading"
            style="@style/NeoSync.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/NeoSync.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/cover_lead" />

        <LinearLayout
            android:id="@+id/cover_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="34dp"
                android:layout_height="48dp"
                android:background="@color/black" />

            <TextView
                style="@style/NeoSync.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/cover_arrow" />

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="48dp"
                android:background="@drawable/cover_bg">

                <TextView
                    android:id="@+id/cover_after_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:maxLines="5"
                    android:padding="2dp"
                    android:textColor="@color/black"
                    android:textSize="6sp" />

                <ImageView
                    android:id="@+id/cover_after_image_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cover_title_1"
                    style="@style/NeoSync.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cover_kind_1"
                    style="@style/NeoSync.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cover_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="34dp"
                android:layout_height="48dp"
                android:background="@color/black" />

            <TextView
                style="@style/NeoSync.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/cover_arrow" />

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="48dp"
                android:background="@drawable/cover_bg">

                <TextView
                    android:id="@+id/cover_after_text_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:maxLines="5"
                    android:padding="2dp"
                    android:textColor="@color/black"
                    android:textSize="6sp" />

                <ImageView
                    android:id="@+id/cover_after_image_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cover_title_2"
                    style="@style/NeoSync.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cover_kind_2"
                    style="@style/NeoSync.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cover_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="34dp"
                android:layout_height="48dp"
                android:background="@color/black" />

            <TextView
                style="@style/NeoSync.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/cover_arrow" />

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="48dp"
                android:background="@drawable/cover_bg">

                <TextView
                    android:id="@+id/cover_after_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:maxLines="5"
                    android:padding="2dp"
                    android:textColor="@color/black"
                    android:textSize="6sp" />

                <ImageView
                    android:id="@+id/cover_after_image_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cover_title_3"
                    style="@style/NeoSync.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cover_kind_3"
                    style="@style/NeoSync.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/cover_more"
            style="@style/NeoSync.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="102dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cover_warning"
            style="@style/NeoSync.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/warn_bg"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textColor="@color/black"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cover_picco_only"
            style="@style/NeoSync.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="@color/black"
            android:checked="false"
            android:minHeight="48dp"
            android:textColor="@color/black"
            android:visibility="gone" />

        <Button
            android:id="@+id/cover_primary"
            style="@style/NeoSync.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp" />

        <TextView
            style="@style/NeoSync.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cover_backup_note" />
    </LinearLayout>
</ScrollView>
