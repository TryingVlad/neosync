<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (spec 5.4, mockup 4): a plain list of rows, title + current value, in groups.
     The rows are filled in by SettingsActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">

<!-- Header: back arrow + title. -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageButton android:id="@+id/button_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="-12dp" android:src="@drawable/ic_arrow_back" android:background="@null" android:padding="12dp" android:contentDescription="@string/cd_back" />

<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/settings_title" style="@style/NeoSync.Title" />
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:paddingBottom="4dp" android:text="@string/settings_sync_header" style="@style/NeoSync.Section" />
<include android:id="@+id/row_auto_sync" layout="@layout/item_setting" />
<include android:id="@+id/row_account" layout="@layout/item_setting" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:paddingBottom="4dp" android:text="@string/settings_permissions_header" style="@style/NeoSync.Section" />
<include android:id="@+id/row_file_access" layout="@layout/item_setting" />
<include android:id="@+id/row_notifications" layout="@layout/item_setting" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:paddingBottom="4dp" android:text="@string/settings_picco_header" style="@style/NeoSync.Section" />
<include android:id="@+id/row_picco" layout="@layout/item_setting" />
<include android:id="@+id/row_folder" layout="@layout/item_setting" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:paddingBottom="4dp" android:text="@string/settings_library_header" style="@style/NeoSync.Section" />
<include android:id="@+id/row_library_types" layout="@layout/item_setting" />
<include android:id="@+id/row_library_folders" layout="@layout/item_setting" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:paddingBottom="4dp" android:text="@string/settings_help_header" style="@style/NeoSync.Section" />
<include android:id="@+id/row_setup_guide" layout="@layout/item_setting" />
<include android:id="@+id/row_report" layout="@layout/item_setting" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:paddingBottom="4dp" android:text="@string/settings_advanced_header" style="@style/NeoSync.Section" />
<include android:id="@+id/row_matching" layout="@layout/item_setting" />
<include android:id="@+id/row_server" layout="@layout/item_setting" />
<include android:id="@+id/row_cover_backups" layout="@layout/item_setting" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:paddingBottom="4dp" android:text="@string/settings_about_header" style="@style/NeoSync.Section" />
<include android:id="@+id/row_version" layout="@layout/item_setting" />

<Button android:id="@+id/button_download_update" android:layout_width="match_parent" android:layout_marginTop="12dp" android:text="" style="@style/NeoSync.Button.Primary" android:visibility="gone" />

<include android:id="@+id/row_support" layout="@layout/item_setting" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/main_footer" style="@style/NeoSync.Small" />

</LinearLayout>
</ScrollView>
