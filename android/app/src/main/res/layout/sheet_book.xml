<?xml version="1.0" encoding="utf-8"?>
<!-- Book sheet (spec 5.2, mockup 2): header, comparison box, one primary
     button, inline result, small links. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/grab_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/sheet_cover"
                android:layout_width="52dp"
                android:layout_height="72dp"
                android:background="@drawable/cover_bg">

                <TextView
                    android:id="@+id/sheet_cover_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:maxLines="6"
                    android:padding="3dp"
                    android:textColor="@color/black"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/sheet_cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sheet_title"
                    style="@style/NeoSync.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_author"
                    style="@style/NeoSync.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/sheet_where"
                    style="@style/NeoSync.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Comparison box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/sheet_row_boox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/NeoSync.Small"
                    android:layout_width="@dimen/sheet_bar_label"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_this_boox"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/sheet_bar_boox"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    android:max="1000"
                    android:maxHeight="10dp"
                    android:minHeight="10dp"
                    android:progressDrawable="@drawable/track_bg" />

                <TextView
                    android:id="@+id/sheet_pct_boox"
                    style="@style/NeoSync.Small"
                    android:layout_width="@dimen/sheet_bar_pct"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_when_boox"
                    style="@style/NeoSync.Small"
                    android:layout_width="@dimen/sheet_when"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sheet_when_margin"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sheet_row_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheet_label_other"
                    style="@style/NeoSync.Small"
                    android:layout_width="@dimen/sheet_bar_label"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/sheet_bar_other"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    android:max="1000"
                    android:maxHeight="10dp"
                    android:minHeight="10dp"
                    android:progressDrawable="@drawable/track_bg" />

                <TextView
                    android:id="@+id/sheet_pct_other"
                    style="@style/NeoSync.Small"
                    android:layout_width="@dimen/sheet_bar_pct"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_when_other"
                    style="@style/NeoSync.Small"
                    android:layout_width="@dimen/sheet_when"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sheet_when_margin"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/sheet_verdict"
                style="@style/NeoSync.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/sheet_primary"
            style="@style/NeoSync.Button.Primary"
            android:layout_width="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sheet_hint"
            style="@style/NeoSync.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sheet_jump_hint"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sheet_result"
            style="@style/NeoSync.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Link rows wrap onto a second line on narrow screens. -->
        <dev.neosync.boox.activity.WrapRow
            android:id="@+id/sheet_links_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/sheet_link_instead"
                style="@style/NeoSync.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sheet_link_instead_2"
                style="@style/NeoSync.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sheet_link_undo"
                style="@style/NeoSync.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_undo"
                android:visibility="gone" />
        </dev.neosync.boox.activity.WrapRow>

        <dev.neosync.boox.activity.WrapRow
            android:id="@+id/sheet_links_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/sheet_link_send_again"
                style="@style/NeoSync.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_send_again"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sheet_link_cover"
                style="@style/NeoSync.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_add_cover"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sheet_link_open"
                style="@style/NeoSync.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_open_reader"
                android:visibility="gone" />
        </dev.neosync.boox.activity.WrapRow>
    </LinearLayout>
</ScrollView>
