<?xml version="1.0" encoding="utf-8"?>
<!-- Warning box: a black bar on the left over a light grey fill (spec 8 allows this one). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/warn_fill" />
        </shape>
    </item>
    <item android:gravity="start|fill_vertical" android:width="3dp">
        <shape>
            <solid android:color="@color/black" />
        </shape>
    </item>
</layer-list>
